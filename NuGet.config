<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    nuget.org for every third-party package, plus the Nur-tricenter organization feed (GitHub
    Packages) for the platform kernels (Nur.Tricenter.*).

    The feed needs a classic GitHub token with read:packages. It is read from the environment,
    never from this file:

      [Environment]::SetEnvironmentVariable("NUGET_USERNAME", "<github-user>", "User")
      [Environment]::SetEnvironmentVariable("NUGET_TOKEN",    "<token>",       "User")

    The Docker build passes the same two values as BuildKit secrets (see Dockerfile).
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Nur-tricenter" value="https://nuget.pkg.github.com/Nur-tricenter/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Mapping is exclusive: only Nur.Tricenter.* is looked up on the organization feed. Everything
    else, Joseco.* included, comes from nuget.org.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Nur-tricenter">
      <package pattern="Nur.Tricenter.*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <Nur-tricenter>
      <add key="Username" value="%NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%NUGET_TOKEN%" />
      <add key="ValidAuthenticationTypes" value="basic" />
    </Nur-tricenter>
  </packageSourceCredentials>

</configuration>
